{
  "name": "@financas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "ops:create-user": "tsx --env-file-if-exists=../../.env src/ops/create-user.ts",
    "ops:migrate": "tsx --env-file-if-exists=../../.env src/ops/migrate.ts",
    "ops:run-job": "tsx --env-file-if-exists=../../.env src/ops/run-job.ts"
  },
  "dependencies": {
    "@financas/shared": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qr": "^0.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
